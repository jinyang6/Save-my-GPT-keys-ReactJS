{
  "name": "save-my-keys",
  "productName": "Save My Keys",
  "version": "1.1.0",
  "description": "A simple app to save your API keys",
  "main": "./src/main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production electron .",
    "dev": "cross-env NODE_ENV=development concurrently \"npm run dev-server\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "dev-server": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.13",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.1",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "html-webpack-plugin": "^5.6.3",
    "path-browserify": "^1.0.1",
    "react-refresh": "^0.14.2",
    "style-loader": "^3.3.4",
    "wait-on": "^8.0.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "keywords": [],
  "author": "jinyang",
  "license": "MIT",
  "dependencies": {
    "ant-design": "^1.0.0",
    "antd": "^5.22.7",
    "concurrently": "^8.2.2",
    "electron-is-dev": "^3.0.1",
    "fs-jetpack": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-sweetalert2": "^0.6.0",
    "wait-on": "^7.2.0"
  }
}
